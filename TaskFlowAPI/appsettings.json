{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=TaskFlowDB;Trusted_Connection=true;Encrypt=false;"
  },
  "ClosedTaskCleanup": {
    "Enabled": true,
    "IntervalDays": 7,
    "DeleteAfterDays": 30,
    "BatchSize": 100
  }
}
